#!/usr/bin/env python3
"""
ROM Groomer CLI entry point.

This script provides the command-line interface for ROM Groomer.
"""

import sys
from pathlib import Path

# Add src to path for development
src_path = Path(__file__).parent.parent / "src"
if src_path.exists():
    sys.path.insert(0, str(src_path))

from romgroomer.cli import cli

if __name__ == '__main__':
    cli()
