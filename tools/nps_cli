    def cmd_stats(self, args):
        """Show collection statistics."""
        print(f"📊 NoPayStation Collection Statistics")
        print(f"   Database: {self.nps_dir}")
        print()
        
        # Load databases
        db = NPSDatabase(self.nps_dir)
        platforms = ['ps3', 'vita', 'psp', 'psx', 'psm']
        
        for platform in platforms:
            try:
                db.load_platform(platform, ['games', 'dlc', 'updates', 'themes', 'demos', 'avatars'])
            except Exception as e:
                if args.verbose:
                    print(f"  Warning: Could not load {platform}: {e}")
        
        # Get stats
        stats = db.get_stats()
        
        print(f"Database Statistics:")
        print(f"  Total entries: {stats['total_entries']:,}")
        print(f"  Platforms: {', '.join(sorted(stats['platforms']))}")
        print(f"  Content types: {', '.join(sorted(stats['types']))}")
        print()
        
        # Platform breakdown
        print("Platform Breakdown:")
        for platform, count in sorted(stats['by_platform'].items()):
            print(f"  {platform.upper()}: {count:,} items")
        print()
        
        # Content type breakdown
        print("Content Type Breakdown:")
        for content_type, count in sorted(stats['by_type'].items()):
            print(f"  {content_type.capitalize()}: {count:,} items")
        
        # Region breakdown if specified
        if args.platform:
            platform_entries = [e for e in db.entries if e.platform == args.platform]
            regions = {}
            for entry in platform_entries:
                region = entry.region or 'Unknown'
                regions[region] = regions.get(region, 0) + 1
            
            print(f"\n{args.platform.upper()} Region Breakdown:")
            for region, count in sorted(regions.items(), key=lambda x: -x[1]):
                print(f"  {region}: {count:,} items")
        
        return 0
    
