    def run(self, argv=None):
        """Run CLI."""
        parser = argparse.ArgumentParser(
            description='NoPayStation unified content management',
            epilog='Examples:\n' + __doc__.split('Examples:')[1].split('"""')[0],
            formatter_class=argparse.RawDescriptionHelpFormatter
        )
        
        parser.add_argument(
            '-v', '--verbose',
            action='store_true',
            help='Show detailed output'
        )
        
        subparsers = parser.add_subparsers(dest='command', help='Command to run')
        
        # Search command
        search_parser = subparsers.add_parser('search', help='Search for content')
        search_parser.add_argument('query', help='Search query (name, title ID, or content ID)')
        search_parser.add_argument('--platform', choices=['ps3', 'vita', 'psp', 'psx', 'psm'],
                                   help='Filter by platform')
        search_parser.add_argument('--region', choices=['USA', 'EUR', 'JPN', 'ASI'],
                                   help='Filter by region')
        search_parser.add_argument('--content-type', 
                                   choices=['games', 'dlc', 'updates', 'themes', 'demos', 'avatars'],
                                   help='Filter by content type')
        search_parser.add_argument('--complete', action='store_true',
                                   help='Search for complete bundles (game + DLC + updates)')
        search_parser.add_argument('--include-themes', action='store_true',
                                   help='Include themes in bundles')
        search_parser.add_argument('--limit', type=int, default=50,
                                   help='Maximum results to show (default: 50)')
        
        # Sync command
        sync_parser = subparsers.add_parser('sync', help='Download content')
        sync_parser.add_argument('--search', help='Search query to sync')
        sync_parser.add_argument('--title-id', help='Specific title ID to sync')
        sync_parser.add_argument('--all-game-data', action='store_true',
                                 help='Sync ALL games with complete bundles (requires --platform)')
        sync_parser.add_argument('--platform', choices=['ps3', 'vita', 'psp', 'psx', 'psm'],
                                 help='Filter by platform')
        sync_parser.add_argument('--region', choices=['USA', 'EUR', 'JPN', 'ASI'],
                                 help='Filter by region')
        sync_parser.add_argument('--complete', action='store_true',
                                 help='Download game + all DLC + updates')
        sync_parser.add_argument('--dry-run', action='store_true',
                                 help='Show what would be downloaded without downloading')
        sync_parser.add_argument('--verify', action='store_true', default=True,
                                 help='Verify SHA256 hashes (default: enabled)')
        sync_parser.add_argument('--no-verify', action='store_false', dest='verify',
                                 help='Skip SHA256 verification')
        
        # Verify command
        verify_parser = subparsers.add_parser('verify', help='Verify existing downloads')
        verify_parser.add_argument('--platform', choices=['ps3', 'vita', 'psp', 'psx', 'psm'],
                                   help='Verify specific platform')
        verify_parser.add_argument('--region', choices=['USA', 'EUR', 'JPN', 'ASI'],
                                   help='Verify specific region')
        verify_parser.add_argument('--fix', action='store_true',
                                   help='Re-download corrupt files')
        
        # Stats command
        stats_parser = subparsers.add_parser('stats', help='Show collection statistics')
        stats_parser.add_argument('--platform', choices=['ps3', 'vita', 'psp', 'psx', 'psm'],
                                  help='Show platform-specific stats')
        stats_parser.add_argument('--region', choices=['USA', 'EUR', 'JPN', 'ASI'],
                                  help='Show region-specific stats')
        
        # Update databases command
        update_parser = subparsers.add_parser('update-databases', 
                                              help='Update TSV databases from NoPayStation')
        update_parser.add_argument('--platform', choices=['ps3', 'vita', 'psp', 'psx', 'psm'],
                                   help='Update specific platform only')
        
        # Parse args
        args = parser.parse_args(argv)
        
        if not args.command:
            parser.print_help()
            return 1
        
        # Route to command handler
        try:
            if args.command == 'search':
                return self.cmd_search(args)
            elif args.command == 'sync':
                return self.cmd_sync(args)
            elif args.command == 'verify':
                return self.cmd_verify(args)
            elif args.command == 'stats':
                return self.cmd_stats(args)
            elif args.command == 'update-databases':
                return self.cmd_update_databases(args)
            else:
                print(f"Unknown command: {args.command}")
                return 1
        except KeyboardInterrupt:
            print("\n\n⚠ Interrupted by user")
            return 130
        except Exception as e:
            print(f"\n❌ Error: {e}")
            if args.verbose:
                import traceback
                traceback.print_exc()
            return 1


def main():
    """Entry point."""
    cli = NPSCli()
    sys.exit(cli.run())


if __name__ == '__main__':
    main()
