# =============================================================================
# ROM Farmer Environment Configuration
# =============================================================================
# Copy this file to .env and customize paths for your setup.
# All paths default to subdirectories within the rom-farmer project folder.
# Override any path to use a different location.
#
# Environment variables use the ROMGROOMER_ prefix for compatibility.
# =============================================================================

# -----------------------------------------------------------------------------
# Workspace Root (optional)
# -----------------------------------------------------------------------------
# The root directory for the ROM Farmer workspace.
# If not set, auto-detects based on pyproject.toml location.
# ROMGROOMER_WORKSPACE=/path/to/rom-farmer

# -----------------------------------------------------------------------------
# Source ROMs Directory
# -----------------------------------------------------------------------------
# Where your source ROM files are stored (e.g., Myrient sync, archives).
# Default: {workspace}/source
ROMGROOMER_SOURCE_DIR=source

# -----------------------------------------------------------------------------
# DAT Files Directory
# -----------------------------------------------------------------------------
# Where No-Intro/Redump/Retool DAT files are stored.
# Default: {workspace}/dats
ROMGROOMER_DATS_DIR=dats

# -----------------------------------------------------------------------------
# Lists Directory
# -----------------------------------------------------------------------------
# Where game list files (Best-Games, delete lists, translations) are stored.
# Default: {workspace}/lists
ROMGROOMER_LISTS_DIR=lists

# -----------------------------------------------------------------------------
# Output Directory
# -----------------------------------------------------------------------------
# Where processed ROM sets will be written.
# Default: {workspace}/output
ROMGROOMER_OUTPUT_DIR=output

# -----------------------------------------------------------------------------
# Temp Directory
# -----------------------------------------------------------------------------
# Working directory for intermediate processing files.
# Default: {workspace}/temp
ROMGROOMER_TEMP_DIR=temp

# -----------------------------------------------------------------------------
# Logs Directory
# -----------------------------------------------------------------------------
# Where log files are written.
# Default: {workspace}/logs
ROMGROOMER_LOGS_DIR=logs

# -----------------------------------------------------------------------------
# State Directory
# -----------------------------------------------------------------------------
# Where build state files are stored (for resume capability).
# Default: {workspace}/state
ROMGROOMER_STATE_DIR=state

# -----------------------------------------------------------------------------
# Metadata Directory
# -----------------------------------------------------------------------------
# Where the metadata database is stored.
# Default: {workspace}/metadata/database
ROMGROOMER_METADATA_DIR=metadata/database

# -----------------------------------------------------------------------------
# ScreenScraper Credentials (for metadata scraping)
# -----------------------------------------------------------------------------
# Get your API credentials at: https://www.screenscraper.fr/
# ss.username=your_username
# ss.password=your_password

# -----------------------------------------------------------------------------
# ROM Cache (for build acceleration)
# -----------------------------------------------------------------------------
# Cache transformed ROMs (CHD, RVZ, 7z) to avoid re-processing.
# Dramatically speeds up rebuilds and enables disk savings via hardlinks.

# Cache directory location
# Default: {workspace}/cache
ROMGROOMER_CACHE_DIR=cache

# Enable/disable caching (true/false)
# Default: true
ROMGROOMER_CACHE_ENABLED=true

# How to provide cached files to output directories:
#   hardlink - Same inode, zero extra space (same filesystem only)
#   symlink  - Cross-filesystem, but breaks if cache moves
#   copy     - Full copy, portable but uses 2x space
# Default: hardlink
ROMGROOMER_CACHE_LINK_MODE=hardlink

# How thoroughly to verify cached files:
#   none   - Trust database, fastest
#   exists - Check file exists (default, recommended)
#   size   - Check exists + size matches
#   md5    - Full hash verification, slowest
# Default: exists
ROMGROOMER_CACHE_VERIFY_LEVEL=exists

# Invalidate cache if tool version changes (true/false)
# Default: true
ROMGROOMER_CACHE_CHECK_TOOL_VERSION=true
