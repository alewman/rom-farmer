!/lists/              # List files (keep in repo - small text files)

# Tools - source trees and build artifacts
tools/*/src/          # Git clones of tool sources (MAME, etc)
tools/*/build/        # Built binaries
tools/bin/            # Symlinks to built tools
tools/*/VERSION.txt   # Version tracking (generated)
tools/*/BUILD_INFO.txt # Build info (generated)
